#
# Hi3798MV100 Linux 7.4 精简内核配置
# 目标：仅保留Hi3798MV100必需支持，关闭所有其他ARM平台/无线/多余文件系统/调试追踪
#

CONFIG_ARM=y
CONFIG_ARM_HAS_GROUP_RELOCS=y
CONFIG_SYS_SUPPORTS_APM_EMULATION=y
CONFIG_HAVE_PROC_CPU=y
CONFIG_NO_IOPORT_MAP=y
CONFIG_STACKTRACE_SUPPORT=y
CONFIG_ARCH_HAS_BANDGAP=y
CONFIG_FIX_EARLYCON_MEM=y
CONFIG_GENERIC_HWEIGHT=y
CONFIG_GENERIC_CALIBRATE_DELAY=y
CONFIG_ARCH_SUPPORTS_UPROBES=y
CONFIG_FIQ=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_GENERIC_BUG=y
CONFIG_PGTABLE_LEVELS=3
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MULTI_V6_V7=y

# 只保留HiSilicon平台，关闭其他所有ARM SoC厂商
CONFIG_ARCH_HISI=y
# CONFIG_ARCH_HI3xxx is not set
# CONFIG_ARCH_HIP01 is not set
# CONFIG_ARCH_HIP04 is not set
# CONFIG_ARCH_HIX5HD2 is not set
# 保留Hi3798MV100相关的HISTB支持（补丁会开启）

# 关闭所有非海思平台
# CONFIG_ARCH_VIRT is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HIGHBANK is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_OMAP is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VT8500 is not set
# CONFIG_ARCH_WM8850 is not set
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AT91 is not set
# CONFIG_ARCH_AXXIA is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_DIGICOLOR is not set
# CONFIG_ARCH_DOVE is not set
# CONFIG_ARCH_KEYSTONE is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MILBEAUT is not set
# CONFIG_ARCH_UNIPHIER is not set

# CPU配置 - 仅保留Cortex-A9（Hi3798MV100是双核A9）
CONFIG_CPU_V7=y
CONFIG_CPU_V7M is not set
CONFIG_ARM_THUMB=y
CONFIG_ARM_THUMBEE=y
CONFIG_ARM_VIRT_EXT=y
CONFIG_ARM_LPAE is not set
CONFIG_VMSPLIT_2G=y
CONFIG_ARM_PATCH_IDIV=y

# 内核压缩用XZ（体积最小）
CONFIG_KERNEL_XZ=y
CONFIG_HAVE_KERNEL_GZIP=y
CONFIG_HAVE_KERNEL_LZMA=y
CONFIG_HAVE_KERNEL_XZ=y
CONFIG_HAVE_KERNEL_LZO=y
CONFIG_HAVE_KERNEL_LZ4=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set

# 基础系统配置
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# 关闭不必要的调试和追踪，大幅减小内核体积
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_FTRACE_SYSCALLS is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_UBSAN is not set
# CONFIG_TRACING is not set
# CONFIG_EVENT_TRACING is not set
# CONFIG_IKCONFIG is not set
# CONFIG_KALLSYMS_ALL is not set
CONFIG_KALLSYMS=y
CONFIG_MAGIC_SYSRQ=y

# 网络基础支持（盒子有线网络必需）
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_HISILICON=y

# 关闭无线/蓝牙/NFC等无用无线模块
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
# CONFIG_NFC is not set
# CONFIG_IEEE802154 is not set
# CONFIG_WLAN is not set

# 块设备
CONFIG_BLOCK=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_EEPROM_AT24=y

# 文件系统 - 只保留常用的ext4/squashfs/vfat，关闭其他冗余文件系统
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_F2FS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
# CONFIG_JFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_MINIX_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y

# 设备树支持
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLYFLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_NET=y
CONFIG_OF_MDIO=y

# 时钟/中断/定时器（Hi3798MV100必需）
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_HI3798MV100=y
CONFIG_CLKSRC_MMIO=y
CONFIG_TIMER_OF=y
CONFIG_ARM_GLOBAL_TIMER=y
CONFIG_HISILICON_TIMER=y

# GPIO/引脚/复位
CONFIG_GPIO_DEVRES=y
CONFIG_OF_GPIO=y
CONFIG_GPIOLIB=y
CONFIG_RESET_CONTROLLER=y

# 电源管理
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_THERMAL=y

# 串口/控制台（调试必需）
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HVC_DRIVER=y
CONFIG_SERIAL_HISI=y
CONFIG_SERIAL_HISI_CONSOLE=y

# I2C/SPI（外设必需）
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_HIX5HD2=y
CONFIG_SPI=y
CONFIG_SPI_HISI=y

# MMC/SD/eMMC存储
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_HISILICON=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_HI3798MV100=y

# USB
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_STORAGE=y
CONFIG_USB_PHY=y
CONFIG_PHY_HISI_INNO_USB2=y

# 以太网驱动
CONFIG_HIX5HD2_GMAC=y
CONFIG_HISI_FEMAC=y
CONFIG_MDIO_BUS=y
CONFIG_FIXED_PHY=y
CONFIG_NET_PHYLIB=y

# DRM显示（盒子显示必需）
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_HISI_HIBMC is not set
CONFIG_DRM_SII9134 is not set
# CONFIG_DRM_SII9134 is not set

# RTC/WDT
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_HISI=y
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y
CONFIG_HISI_WATCHDOG=y

# 传感器/随机数/温度
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_HISTB=y
CONFIG_THERMAL=y
CONFIG_HISI_THERMAL=y
CONFIG_HI3798MV100_THERMAL=y

# NAND/MTD
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_HISI=y

# 关闭完整V4L/DVB媒体子系统，只保留必要的显示相关
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_DVB_CORE is not set

# 音频（盒子需要）
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_HISILICON=y

# 关闭Kexec/CRASH等高级特性
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set

# 关闭BPF高级特性（嵌入式不需要）
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
